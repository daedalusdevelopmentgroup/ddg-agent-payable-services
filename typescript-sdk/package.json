{
  "name": "@daedalusdevelopmentgroup/ddg-x402",
  "version": "0.1.0",
  "description": "Spend-capped x402 TypeScript client for canonical DDG agent services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {"node": ">=20"},
  "dependencies": {
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "viem": "^2.39.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daedalusdevelopmentgroup/ddg-agent-payable-services.git",
    "directory": "typescript-sdk"
  }
}

